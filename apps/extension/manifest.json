{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "Space",
  "version": "0.1.0",
  "description": "Fill credentials from Space on the page you choose.",
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Space", "default_popup": "popup.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
